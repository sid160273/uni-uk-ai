# Site Configuration
NEXT_PUBLIC_SITE_URL=https://uni-uk.ai

# AI Integration (REQUIRED for chatbot to work)
OPENAI_API_KEY=your_openai_api_key_here

# Analytics (Optional)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_GOOGLE_ANALYTICS=your_ga_tracking_id

# Google AdSense (Optional)
# NEXT_PUBLIC_ADSENSE_ID=ca-pub-xxxxxxxxxx

# Database (if needed in future)
# DATABASE_URL=postgresql://...

# Email (if needed for contact forms)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_email@example.com
# SMTP_PASSWORD=your_password

# Google Analytics 4 Data API - for automated chat data collection
GA4_PROPERTY_ID=your_ga4_property_id
GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# Vercel Cron Secret - protects the cron endpoint from unauthorized access
CRON_SECRET=your_random_secret_key_here

# Google Ads API Configuration - for admin dashboard and campaign management
GOOGLE_ADS_CLIENT_ID=your_oauth_client_id_here
GOOGLE_ADS_CLIENT_SECRET=your_oauth_client_secret_here
GOOGLE_ADS_DEVELOPER_TOKEN=your_developer_token_here
GOOGLE_ADS_REFRESH_TOKEN=your_refresh_token_here
GOOGLE_ADS_CUSTOMER_ID=123-456-7890
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=123-456-7890  # Optional: only for manager accounts

# Admin Dashboard Authentication
ADMIN_SECRET_KEY=generate_strong_random_key_with_openssl_rand_hex_32
